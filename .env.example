# PayPal sandbox credentials.
# Get these from the PayPal Developer Dashboard: https://developer.paypal.com/dashboard/
# Use SANDBOX credentials. Never commit real ones.
#
#   cp .env.example .env     # then fill it in, and keep .env out of git
#
# .env is already gitignored. Verify with:  git check-ignore .env

PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# The merchant whose PayPal resources the policy is written against.
# It appears in every scope target, as paypal/merchant/<PAYPAL_MERCHANT_ID>/...
PAYPAL_MERCHANT_ID=ACME-MERCH-4417

# Always "sandbox" for this project. Set to "live" only with real credentials
# and a policy you have read line by line.
PAYPAL_ENVIRONMENT=sandbox

# Model used by examples/agentsdk_agent.py.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o