# Normalise line endings on checkout so the demo, tests, and lint behave the
# same on Windows, macOS, and Linux. Judges will run this on all three.
* text=auto eol=lf

*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.md text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

*.png binary
*.jpg binary
*.svg text eol=lf